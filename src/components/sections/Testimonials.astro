---

<section id="testimonials" class="testimonials-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Success Stories</span>
      <h2>Real impact for <span class="text-primary">Real Businesses</span></h2>
      <p>Hear from business owners who scaled their sales operations with LeadMan.</p>
    </div>

    <div class="testimonial-slider-container">
      <div class="testimonial-slider" id="testimonialSlider">
        {testimonials.map((t, index) => (
          <div class={`testimonial-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
            <div class="testimonial-card">
              <div class="quote-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" opacity="0.1">
                  <path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V12C14.017 12.5523 13.5693 13 13.017 13H11.017C10.4647 13 10.017 12.5523 10.017 12V9C10.017 7.34315 11.3602 6 13.017 6H19.017C20.6739 6 22.017 7.34315 22.017 9V15C22.017 17.7614 19.7784 20 17.017 20H14.017V21ZM5.017 21L5.017 18C5.017 16.8954 5.91243 16 7.017 16H10.017C10.5693 16 11.017 15.5523 11.017 15V9C11.017 8.44772 10.5693 8 10.017 8H6.017C5.46472 8 5.017 8.44772 5.017 9V12C5.017 12.5523 4.56929 13 4.017 13H2.017C1.46472 13 1.01704 12.5523 1.01704 12V9C1.01704 7.34315 2.36019 6 4.01704 6H10.017C11.6739 6 13.017 7.34315 13.017 9V15C13.017 17.7614 10.7784 20 8.017 20H5.017V21Z"></path>
                </svg>
              </div>
              
              <p class="quote">"{t.quote}"</p>
              
              <div class="author-info">
                <div class="avatar" style={`background-color: ${t.color}`}>
                  {t.initials}
                </div>
                <div class="meta">
                  <span class="name">{t.author}</span>
                  <span class="title">{t.title}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="slider-dots">
        {testimonials.map((_, index) => (
          <button class={`dot ${index === 0 ? 'active' : ''}`} data-index={index} aria-label={`Go to slide ${index + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background-color: #f8fbff;
    overflow: hidden;
  }

  .section-header {
    margin-bottom: 64px;
  }

  .section-tag {
    font-weight: 800;
    color: #0066cc;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    display: block;
    margin-bottom: 16px;
  }

  .testimonial-slider-container {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }

  .testimonial-slider {
    position: relative;
    height: 420px;
  }

  .testimonial-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(50px);
  }

  .testimonial-slide.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .testimonial-card {
    background: #ffffff;
    padding: 60px;
    border-radius: 32px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 20px 50px rgba(0, 102, 204, 0.05);
  }

  .quote-icon {
    margin-bottom: 24px;
    color: #0066cc;
  }

  .quote {
    font-size: 1.25rem;
    font-style: italic;
    color: #1e293b;
    line-height: 1.8;
    margin-bottom: 40px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 32px;
    border-top: 1px solid #f1f5f9;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
  }

  .name {
    font-weight: 800;
    color: #111827;
    font-size: 1.1rem;
  }

  .title {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 600;
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #cbd5e1;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: #0066cc;
    width: 32px;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .testimonial-card {
      padding: 32px;
    }
    .testimonial-slider {
      height: 550px;
    }
    .quote {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  function initSlider() {
    const slides = document.querySelectorAll('.testimonial-slide');
    const dots = document.querySelectorAll('.dot');
    let currentSlide = 0;

    function showSlide(index) {
      slides.forEach(s => s.classList.remove('active'));
      dots.forEach(d => d.classList.remove('active'));
      
      slides[index].classList.add('active');
      dots[index].classList.add('active');
      currentSlide = index;
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);
      });
    });

    // Auto slide
    setInterval(() => {
      let next = (currentSlide + 1) % slides.length;
      showSlide(next);
    }, 6000);
  }

  // Initialize on load
  initSlider();
  
  // Re-init on Astro transitions if using them
  document.addEventListener('astro:after-swap', initSlider);
</script>

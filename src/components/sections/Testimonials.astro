---

<section id="testimonials" class="testimonials-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Success Stories</span>
      <h2>Real impact for <span class="text-primary">Real Businesses</span></h2>
      <p>Hear from business owners who scaled their sales operations with LeadMan.</p>
    </div>

    <div class="testimonial-carousel-wrapper">
      <div class="testimonial-track" id="testimonialTrack">
        {/* Render twice for infinite effect */}
        {[...testimonials, ...testimonials].map((t) => (
          <div class="testimonial-item">
            <div class="testimonial-card">
              <div class="quote-icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" opacity="0.1">
                  <path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V12C14.017 12.5523 13.5693 13 13.017 13H11.017C10.4647 13 10.017 12.5523 10.017 12V9C10.017 7.34315 11.3602 6 13.017 6H19.017C20.6739 6 22.017 7.34315 22.017 9V15C22.017 17.7614 19.7784 20 17.017 20H14.017V21ZM5.017 21L5.017 18C5.017 16.8954 5.91243 16 7.017 16H10.017C10.5693 16 11.017 15.5523 11.017 15V9C11.017 8.44772 10.5693 8 10.017 8H6.017C5.46472 8 5.017 8.44772 5.017 9V12C5.017 12.5523 4.56929 13 4.017 13H2.017C1.46472 13 1.01704 12.5523 1.01704 12V9C1.01704 7.34315 2.36019 6 4.01704 6H10.017C11.6739 6 13.017 7.34315 13.017 9V15C13.017 17.7614 10.7784 20 8.017 20H5.017V21Z"></path>
                </svg>
              </div>
              <p class="quote">"{t.quote}"</p>
              <div class="author-info">
                <div class="avatar" style={`background-color: ${t.color}`}>
                  {t.initials}
                </div>
                <div class="meta">
                  <span class="name">{t.author}</span>
                  <span class="title">{t.title}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background-color: #f8fbff;
    overflow: hidden;
  }

  .testimonial-carousel-wrapper {
    margin-top: 40px;
    width: 100%;
    overflow: hidden;
  }

  .testimonial-track {
    display: flex;
    gap: 30px;
    width: fit-content;
    animation: scroll 60s linear infinite;
  }

  .testimonial-item {
    width: 400px;
    flex-shrink: 0;
  }

  .testimonial-card {
    background: #ffffff;
    padding: 40px;
    border-radius: 24px;
    border: 1px solid #e5e7eb;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 102, 204, 0.05);
  }

  .quote-icon {
    margin-bottom: 20px;
    color: #0066cc;
  }

  .quote {
    font-size: 1rem;
    font-style: italic;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 30px;
    flex-grow: 1;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid #f1f5f9;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .name {
    display: block;
    font-weight: 800;
    color: #111827;
    font-size: 0.95rem;
  }

  .title {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 600;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-430px * 6)); } /* card width + gap * count */
  }

  .testimonial-track:hover {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .testimonial-item {
      width: 320px;
    }
    @keyframes scroll {
      100% { transform: translateX(calc(-350px * 6)); }
    }
  }
</style>

---
const clientLogos = [
  "AIM.png", "Ajantalogo.png", "Emisunlogo.png", "EnvitroLab.png", 
  "FMC.png", "GenesisSolar.png", "Gmt-1.png", "HPTLOGO.png", 
  "Jayshakti.png", "Jse.png", "NovaValves-300x90.png", "RaftarLogo.png", 
  "SKlogo.png", "SVCNC-150x150.png", "Sahara.png", "ShreeMomaiLogo.png", 
  "ShrutiKitchanware.png", "SweetBite-150x150.png", "vimox-logo-300x74.png",
  "bell-agrotech.png", "dkmachineries.png", "equinoxsolar.png", "jks-engineering.png",
  "madhurammotors.png", "shanpetro.png", "shivshaktiautomation.png", "avsarIndustries.png",
  "growmore.png", "harihar.png", "imagecreation.png", "marvelagro.png",
  "microcapmarketplace.png", "naagmani.png", "neoncables.png", "nexeva.png",
  "omkar.png", "princezatka.png", "raviraj.png", "shivtelecom.png",
  "svcnc.png", "westernsurgical.png", "zolita.png"
];
---

<section class="clients-section">
  <div class="container">
    <p class="section-tag">Trusted by 250+ Business Owners Across India</p>
  </div>
  
  <div class="logo-track" id="client-logo-track">
    <div class="logo-list">
      {clientLogos.map((logo) => (
        <div class="logo-item">
          <img src={`/images/clients/${logo}`} alt="Client Logo" class="client-img" />
        </div>
      ))}
      {/* Duplicate for infinite loop */}
      {clientLogos.map((logo) => (
        <div class="logo-item">
          <img src={`/images/clients/${logo}`} alt="Client Logo" class="client-img" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clients-section {
    padding: 80px 0;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    overflow: hidden;
  }

  .section-tag {
    text-align: center;
    font-size: 1.5rem;
    color: #1e293b;
    margin-bottom: 50px;
    font-weight: 900;
    background: linear-gradient(90deg, #0066cc, #0a84ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo-track {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-behavior: auto;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .logo-track::-webkit-scrollbar {
    display: none;
  }

  .logo-list {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .logo-item {
    width: 280px;
    padding: 0 50px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .client-img {
    max-width: 190px;
    max-height: 85px;
    width: auto;
    height: auto;
    transition: all 0.3s ease;
  }

  .logo-item:hover .client-img {
    transform: scale(1.1);
  }



  @media (max-width: 768px) {
    .clients-section {
      padding: 40px 0;
    }
    .section-tag {
      font-size: 1.1rem;
      margin-bottom: 30px;
    }
    .logo-item {
      width: 140px;
      padding: 0 10px;
    }
    .client-img {
      max-width: 120px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('client-logo-track');
    if (!track) return;
    
    let isPaused = false;
    let autoScrollSpeed = 1.5; // Change this value to adjust speed
    
    // Pause auto-scroll when user interacts
    track.addEventListener('mouseenter', () => isPaused = true);
    track.addEventListener('mouseleave', () => isPaused = false);
    
    track.addEventListener('touchstart', () => isPaused = true);
    track.addEventListener('touchend', () => {
      // Resume shortly after swiping
      setTimeout(() => isPaused = false, 1500); 
    });

    function autoScroll() {
      if (!isPaused) {
        track.scrollLeft += autoScrollSpeed;
        
        // When we reach the exact middle (end of first list), jump back to 0 seamlessly
        if (track.scrollLeft >= track.scrollWidth / 2) {
          track.scrollLeft = 0;
        }
      }
      requestAnimationFrame(autoScroll);
    }
    
    // Start loop
    requestAnimationFrame(autoScroll);
  });
</script>

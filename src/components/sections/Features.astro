---
const features = [
  {
    title: "Lead Management",
    desc: "Centralized inquiry tracking and automated follow-up reminders.",
    items: ["Inquiry Tracking", "Follow-up Reminders", "Sales Stage Coding", "History Logs"]
  },
  {
    title: "Sales Execution",
    desc: "Generate professional PDF quotations and invoices instantly.",
    items: ["Instant PDF Gen", "Version Tracking", "One-click Conversions", "Branded Proposals"]
  },
  {
    title: "Automation & AI",
    desc: "Smart lead assignment and integrated AI calling for engagement.",
    items: ["Auto Assignment", "AI Calling", "Workflow Automation", "WhatsApp Sync"]
  },
  {
    title: "Intelligence & ROI",
    desc: "Dynamic dashboards to understand marketing channel value.",
    items: ["KPI Tracking", "Lead Source ROI", "Call Analysis", "Custom Views"]
  }
];
---

<section id="features" class="features-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Powerful Capabilities</span>
      <h2>Depth You Can <span class="text-primary">Use</span></h2>
      <p>Practical features designed to solve real operational challenges for Indian SMEs.</p>
    </div>

    <div class="grid grid-2">
      {features.map(feature => (
        <div class="feature-card">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.desc}</p>
          <ul class="feature-list">
            {feature.items.map(item => (
              <li>
                <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    background-color: #f8fafc;
  }

  .section-header {
    margin-bottom: 64px;
  }

  .section-tag {
    font-weight: 800;
    color: #0066cc;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    display: block;
    margin-bottom: 16px;
  }

  .feature-card {
    background: #ffffff;
    padding: 48px;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
  }

  .feature-card:hover {
    border-color: #0066cc;
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
  }

  .card-icon {
    width: 56px;
    height: 56px;
    background: #f0f7ff;
    color: #0066cc;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .feature-card h3 {
    font-size: 1.75rem;
    margin-bottom: 12px;
  }

  .feature-card p {
    color: #64748b;
    font-size: 1.1rem;
    margin-bottom: 32px;
  }

  .feature-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1e293b;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: #10b981;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .feature-list {
      grid-template-columns: 1fr;
    }
    .feature-card {
      padding: 32px;
    }
  }
</style>

---
---
<section class="product-showcase section-padding">
  <div class="container">
    <div class="showcase-header text-center">
      <h2 class="text-gradient">Experience the Interface</h2>
      <p>Clean, intuitive, and designed for high-speed sales operations on any device.</p>
    </div>
    
    <div class="showcase-grid">
      <div class="showcase-item">
        <div class="device-frame desktop">
          <img src="/dashboard-mockup.png" alt="LeadMan CRM Desktop Dashboard" />
        </div>
        <div class="showcase-info">
          <h3>Full Desktop Power</h3>
          <p>Get a bird's-eye view of your entire business with advanced reporting and pipeline tracking.</p>
        </div>
      </div>
      
      <div class="showcase-item reverse">
        <div class="device-frame mobile">
          <img src="/mobile-mockup.png" alt="LeadMan CRM Mobile App" />
        </div>
        <div class="showcase-info">
          <h3>Mobility for Your Team</h3>
          <p>Track leads, record meeting notes, and send WhatsApp follow-ups on the go with our dedicated mobile app.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-header {
    margin-bottom: var(--space-16);
  }

  .showcase-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .showcase-item {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: var(--space-12);
  }

  .showcase-item.reverse {
    grid-template-columns: 1fr 1.5fr;
  }

  .device-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--color-slate-200);
    background: var(--color-white);
  }

  .device-frame.mobile {
    max-width: 320px;
    margin: 0 auto;
    border-radius: 2rem;
    border: 8px solid var(--color-slate-800);
  }

  .device-frame img {
    width: 100%;
    display: block;
  }

  .showcase-info h3 {
    margin-bottom: var(--space-4);
    color: var(--color-primary-700);
  }

  @media (max-width: 768px) {
    .showcase-item, .showcase-item.reverse {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .showcase-item.reverse .showcase-info {
      order: -1;
    }
  }
</style>

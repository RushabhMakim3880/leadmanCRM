---
---
<section id="contact" class="contact-section section-padding">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-text">
        <span class="section-tag">Contact Us</span>
        <h2>Ready to <span class="text-primary">Scale?</span></h2>
        <p class="description">Book a personalized walkthrough and see how LeadMan can transform your sales operations.</p>
        
        <div class="contact-methods">
          <div class="method-item">
            <div class="method-icon">📍</div>
            <div class="method-content">
              <h4>VISIT US</h4>
              <p>S-405, Twinstar, 150 Ring Road, Rajkot (Gujarat)</p>
            </div>
          </div>
          <div class="method-item">
            <div class="method-icon">📞</div>
            <div class="method-content">
              <h4>CALL US</h4>
              <p>+91 94097 60076</p>
            </div>
          </div>
          <div class="method-item">
            <div class="method-icon">✉️</div>
            <div class="method-content">
              <h4>EMAIL US</h4>
              <p>info@leadman.in</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <form class="lead-form">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" placeholder="e.g. Rajesh Kumar" required />
          </div>
          <div class="form-group">
            <label>Business Name</label>
            <input type="text" placeholder="e.g. Mehta Engineering" required />
          </div>
          <div class="form-group">
            <label>Phone Number</label>
            <input type="tel" placeholder="e.g. +91 98765 43210" required />
          </div>
          <button type="submit" class="btn btn-primary btn-full">Request Demo</button>
          <p class="form-note">No credit card required. Onboarding assistance included.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: #f8fbff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .section-tag {
    font-weight: 800;
    color: #0066cc;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    display: block;
    margin-bottom: 16px;
  }

  .description {
    font-size: 1.25rem;
    color: #4b5563;
    margin-bottom: 48px;
  }

  .contact-methods {
    display: grid;
    gap: 32px;
  }

  .method-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .method-icon {
    width: 48px;
    height: 48px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .method-content h4 {
    font-size: 0.75rem;
    font-weight: 800;
    color: #6b7280;
    margin-bottom: 4px;
    letter-spacing: 1px;
  }

  .method-content p {
    font-weight: 700;
    color: #111827;
    margin-bottom: 0;
  }

  .contact-form-wrapper {
    background: #ffffff;
    padding: 48px;
    border-radius: 32px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 20px 50px rgba(0, 102, 204, 0.08);
  }

  .btn-full {
    width: 100%;
    margin-top: 12px;
  }

  .form-note {
    text-align: center;
    font-size: 0.85rem;
    color: #6b7280;
    margin-top: 20px;
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .contact-form-wrapper {
      padding: 32px;
    }
  }
</style>

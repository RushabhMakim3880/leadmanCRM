---

<section class="why-choose-section">
  <div class="container">
    <div class="section-header text-center">
      <h2>Why Choose <span class="text-primary">Leadman CRM?</span></h2>
      <p>The strategic choice for businesses looking to scale operations and automate growth.</p>
    </div>

    <div class="why-grid">
      {reasons.map((item) => (
        <div class="why-item">
          <div class="why-icon" set:html={iconMap[item.icon]} />
          <div class="why-content">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-choose-section {
    padding: 60px 0;
    background-color: #ffffff;
  }

  .section-header {
    margin-bottom: 64px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .why-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 32px;
    border-radius: 20px;
    transition: all 0.3s ease;
    background: #f0f7ff;
    border: 1px solid #0a84ff;
    box-shadow: 0 4px 6px rgba(10, 132, 255, 0.05);
  }

  .why-item:hover {
    transform: translateY(-5px);
    background: #ffffff;
    box-shadow: 0 15px 30px rgba(0, 102, 204, 0.1);
  }

  .why-icon {
    width: 32px;
    height: 32px;
    color: #0066cc;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .why-content h3 {
    font-size: 1.25rem;
    margin-bottom: 8px;
    color: #111827;
  }

  .why-content p {
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .why-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .why-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .why-item {
      padding: 24px 0;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid #e2e8f0;
      background: transparent;
      box-shadow: none;
    }
    .why-item:last-child {
      border-bottom: none;
    }
    .why-item:hover {
      transform: none;
      background: transparent;
      box-shadow: none;
    }
  }
</style>

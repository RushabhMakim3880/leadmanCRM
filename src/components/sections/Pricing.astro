---
const plans = [
  {
    name: "Starter",
    price: 500,
    users: 5,
    features: [
      "Leads Management",
      "Quotation & PI",
      "Order Management",
      "Invoice & Dispatch",
      "Customer Management",
      "FB Lead Form Integration",
      "Indiamart API Integration",
      "Tradeindia API Integration",
      "Exporter India API",
      "GST Verification",
    ],
    cta: "Start Basic",
    recommended: false,
  },
  {
    name: "Dominator",
    price: 1000,
    users: 3,
    features: [
      "Everything in Starter",
      "Basic Inventory Management",
      "Pending Payment Tracking",
      "Task Management Module",
      "Meeting Notes & Reminders",
      "Dynamic Dashboard",
      "Multi Currency Support",
      "Webhooks & Integration",
      "Field Visits Tracker",
      "Lead Source ROI Tracking",
    ],
    cta: "Go Dominator",
    recommended: true,
  },
  {
    name: "Accelerator",
    price: 1250,
    users: 2,
    features: [
      "Everything in Dominator",
      "Org Hierarchy Reporting",
      "Lead Team Collaboration",
      "Email Integration",
      "Work Flow Automation",
      "Custom Fields & Pipelines",
      "Full API Access",
      "Power Calling Integration",
      "Visitor Diary",
      "Priority Support",
    ],
    cta: "Scale Now",
    recommended: false,
  },
];
---

<section id="pricing" class="pricing-section section-padding">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">Pricing Plans</span>
      <h2>Plans built for every stage of <span class="text-primary">Growth</span></h2>
      <p>Choose the perfect fit for your sales team. No hidden charges.</p>
    </div>

    <div class="pricing-grid">
      {plans.map((plan) => (
        <div class={`pricing-card ${plan.recommended ? 'recommended' : ''}`}>
          {plan.recommended && <div class="popular-tag">Most Popular</div>}
          
          <div class="card-header">
            <h3>{plan.name}</h3>
            <div class="price-box">
              <span class="currency">₹</span>
              <span class="amount">{plan.price}</span>
              <span class="period">/user/mo</span>
            </div>
            <p class="user-limit">Min. {plan.users} Users</p>
          </div>

          <div class="card-features">
            <ul>
              {plan.features.map((feature) => (
                <li>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <div class="card-footer">
            <a href="#" class={`btn ${plan.recommended ? 'btn-primary' : 'btn-outline'} open-modal`}>
              {plan.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="topup-container">
      <div class="topup-grid">
        <div class="topup-card">
          <h4>Additional Top-ups</h4>
          <table class="topup-table">
            <tr>
              <td>Storage</td>
              <td class="text-right"><strong>₹160 / 5GB</strong></td>
            </tr>
            <tr>
              <td>Data Points</td>
              <td class="text-right"><strong>₹250 / 25K Records</strong></td>
            </tr>
            <tr>
              <td>Whatsapp Messages</td>
              <td class="text-right">
                <strong>₹250 / 100K</strong>
                <span class="sub-label">Total In/Out Messages</span>
              </td>
            </tr>
            <tr>
              <td>Whatsapp Integration</td>
              <td class="text-right"><strong>₹1000 / Month</strong></td>
            </tr>
          </table>
        </div>

        <div class="topup-card">
          <h4>Included Limits</h4>
          <table class="topup-table">
            <tr>
              <td>Storage Limit</td>
              <td class="text-right"><strong>1GB / User</strong></td>
            </tr>
            <tr>
              <td>Data Points</td>
              <td class="text-right"><strong>25K / User</strong></td>
            </tr>
            <tr>
              <td>Whatsapp Messages</td>
              <td class="text-right"><strong>25K / User</strong></td>
            </tr>
          </table>
          <div class="note-box">
            * Integration costs are per account, not per user.
          </div>
        </div>
      </div>
    </div>

    <div class="pricing-footer text-center">
      <p>* All prices are per month. Billed annually. 18% GST applicable.</p>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background: #ffffff;
  }

  .section-header {
    margin-bottom: 64px;
  }

  .section-tag {
    font-weight: 800;
    color: #0066cc;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    display: block;
    margin-bottom: 16px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
  }

  .pricing-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s ease;
  }

  .pricing-card:hover {
    border-color: #0066cc;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  .pricing-card.recommended {
    border: 2px solid #0066cc;
    background: #f8fbff;
    transform: scale(1.05);
    z-index: 10;
  }

  .popular-tag {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #0066cc;
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .card-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .price-box {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin: 16px 0 8px;
  }

  .currency {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .amount {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -2px;
    color: #111827;
  }

  .period {
    font-size: 1rem;
    color: #6b7280;
  }

  .user-limit {
    font-size: 0.9rem;
    color: #0066cc;
    font-weight: 800;
  }

  .card-features {
    flex-grow: 1;
    margin-bottom: 48px;
  }

  .card-features ul {
    list-style: none;
    padding: 0;
  }

  .card-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: #10b981;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-footer .btn {
    width: 100%;
    padding: 18px;
  }

  .pricing-footer {
    margin-top: 48px;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .topup-container {
    margin-top: 80px;
    background: #f8fbff;
    padding: 60px;
    border-radius: 32px;
    border: 1px solid #e5e7eb;
  }

  .topup-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .topup-card h4 {
    font-size: 1.25rem;
    color: #111827;
    margin-bottom: 24px;
    font-weight: 800;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 12px;
  }

  .topup-table {
    width: 100%;
    border-collapse: collapse;
  }

  .topup-table td {
    padding: 16px 0;
    border-bottom: 1px solid #e2e8f0;
    color: #4b5563;
    font-size: 1rem;
  }

  .topup-table tr:last-child td {
    border-bottom: none;
  }

  .text-right {
    text-align: right;
  }

  .text-right strong {
    color: #111827;
  }

  .sub-label {
    display: block;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-top: 4px;
  }

  .note-box {
    margin-top: 32px;
    padding: 16px;
    background: #ffffff;
    border-radius: 12px;
    font-size: 0.85rem;
    color: #64748b;
    border: 1px solid #e2e8f0;
  }

  @media (max-width: 992px) {
    .topup-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .topup-container {
      padding: 30px 20px;
    }
  }

  @media (max-width: 768px) {
    .pricing-card.recommended {
      transform: scale(1);
    }
  }
</style>

---
---

<div id="contactModal" class="modal-overlay">
  <div class="modal-content">
    <button id="closeModal" class="close-btn" aria-label="Close Modal">&times;</button>
    
    <div class="modal-grid">
      <div class="modal-info">
        <span class="modal-tag">Contact Us</span>
        <h2>Ready to <span class="text-primary">Scale?</span></h2>
        <p>Book a personalized walkthrough and see how LeadMan can transform your sales operations.</p>
        
        <div class="contact-methods">
          <div class="method-item">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="method-text">
          <div class="method-item">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="method-text">
              <label>Call Us</label>
              <span>+91 94097 60076</span>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-form-box">
        <form class="modal-form">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" placeholder="e.g. Rajesh Kumar" required />
          </div>
          <div class="form-group">
            <label>Business Name</label>
            <input type="text" placeholder="e.g. Mehta Engineering" required />
          </div>
          <div class="form-group">
            <label>Phone Number</label>
            <input type="tel" placeholder="e.g. +91 98765 43210" required />
          </div>
          <button type="submit" class="btn btn-primary btn-block">Request Demo</button>
          <p class="form-footer">No credit card required. Onboarding assistance included.</p>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 20px;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    background: #ffffff;
    width: 100%;
    max-width: 900px;
    border-radius: 32px;
    position: relative;
    overflow: hidden;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 50px 100px rgba(0, 0, 0, 0.3);
  }

  .modal-overlay.active .modal-content {
    transform: translateY(0);
  }

  .close-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    background: #f1f5f9;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .close-btn:hover {
    background: #e2e8f0;
    transform: rotate(90deg);
  }

  .modal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .modal-info {
    padding: 60px;
    background: #f8fbff;
    border-right: 1px solid #e5e7eb;
  }

  .modal-tag {
    color: #0066cc;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 16px;
  }

  .modal-info h2 {
    font-size: 2.5rem;
    margin-bottom: 24px;
    line-height: 1.1;
  }

  .modal-info p {
    color: #64748b;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .method-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .method-icon svg {
    width: 20px;
    height: 20px;
    color: #0066cc;
  }

  .method-text label {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 2px;
  }

  .method-text span {
    font-weight: 700;
    color: #1e293b;
  }

  .modal-form-box {
    padding: 60px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .form-group input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .form-group input:focus {
    border-color: #0066cc;
    outline: none;
    box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.1);
  }

  .btn-block {
    width: 100%;
    margin-top: 10px;
  }

  .form-footer {
    text-align: center;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 20px;
  }

  @media (max-width: 850px) {
    .modal-grid { grid-template-columns: 1fr; }
    .modal-info { display: none; }
    .modal-content { max-width: 450px; }
    .modal-form-box { padding: 40px 24px; }
  }
</style>

<script>
  function initModal() {
    const modal = document.getElementById('contactModal');
    const closeBtn = document.getElementById('closeModal');
    const triggers = document.querySelectorAll('.open-modal');

    function openModal(e) {
      if (e) e.preventDefault();
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
    });
  }

  initModal();
  document.addEventListener('astro:after-swap', initModal);
</script>

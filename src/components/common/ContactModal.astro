---
---

<div id="contactModal" class="modal-overlay">
    <div class="modal-card">
      <button class="close-modal" id="closeModal">&times;</button>
      
      <div class="modal-grid">
        <div class="modal-info">
          <span class="badge">Contact Us</span>
          <h2>Ready to <span>Scale?</span></h2>
          <p>Book a personalized walkthrough and see how LeadMan can transform your sales operations.</p>
          
          <div class="contact-methods">
            <div class="method-item">
              <div class="method-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div class="method-text">
                <label>Call Us</label>
                <span>+91 94097 60076</span>
              </div>
            </div>
            <div class="method-item">
              <div class="method-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="method-text">
                <label>Email Us</label>
                <span>info@leadman.in</span>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-form-container">
          <form class="modal-form">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" placeholder="e.g. Rajesh Kumar" required />
            </div>
            <div class="form-group">
              <label>Business Name</label>
              <input type="text" placeholder="e.g. Mehta Engineering" required />
            </div>
            <div class="form-group">
              <label>Phone Number</label>
              <input type="tel" placeholder="e.g. +91 98765 43210" required />
            </div>
            <button type="submit" class="btn-submit">Request Demo</button>
            <p class="form-note">No credit card required. Onboarding assistance included.</p>
          </form>
        </div>
      </div>
    </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 20px;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .close-modal {
    position: absolute;
    top: 24px;
    right: 24px;
    background: #f1f5f9;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .close-modal:hover {
    background: #e2e8f0;
    transform: rotate(90deg);
  }

  .modal-card {
    background: white;
    width: 95%;
    max-width: 900px;
    border-radius: 32px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .modal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .modal-info {
    padding: 60px;
    background: #f8fbff;
    border-right: 1px solid #e5e7eb;
  }

  .modal-info .badge {
    color: #0066cc;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.8rem;
    display: inline-block;
    margin-bottom: 24px;
    letter-spacing: 1px;
  }

  .modal-info h2 {
    font-size: 2.5rem;
    color: #111827;
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .modal-info h2 span {
    color: #0066cc;
  }

  .modal-info p {
    color: #64748b;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .method-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .method-icon svg {
    width: 20px;
    height: 20px;
    color: #0066cc;
  }

  .method-text label {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 2px;
  }

  .method-text span {
    font-weight: 700;
    color: #1e293b;
  }

  .modal-form-container {
    padding: 60px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .form-group input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .form-group input:focus {
    border-color: #0066cc;
    outline: none;
    box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.1);
  }

  .btn-submit {
    width: 100%;
    background: #0066cc;
    color: white;
    padding: 16px;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 12px;
  }

  .btn-submit:hover {
    background: #0052a3;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 102, 204, 0.2);
  }

  .form-note {
    text-align: center;
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 20px;
    line-height: 1.5;
  }

  @media (max-width: 850px) {
    .modal-grid { grid-template-columns: 1fr; }
    .modal-info { display: none; }
    .modal-card { max-width: 500px; }
  }
</style>

<script>
  function initModal() {
    const modal = document.getElementById('contactModal');
    const closeBtn = document.getElementById('closeModal');
    const triggers = document.querySelectorAll('.open-modal');

    if (!modal || !closeBtn) return;

    function openModal(e?: Event) {
      if (e) e.preventDefault();
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e: Event) => {
      if (e.target === modal) closeModal();
    });

    // ESC key to close
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
    });
  }

  initModal();
  document.addEventListener('astro:after-swap', initModal);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import ContactSection from '../components/sections/Contact.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout title="Contact Us | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="contact-hero">
      <div class="container">
        <h1>Let's Start a <span>Conversation</span></h1>
        <p>Whether you have a question about features, pricing, or a custom demo—our team is ready to help.</p>
      </div>
    </section>

    <div class="contact-wrapper">
      <ContactSection />
    </div>

    <section class="location-section">
      <div class="container">
        <div class="location-card">
          <div class="location-info">
            <span class="badge">Headquarters</span>
            <h2>Visit our <span>Office</span></h2>
            <p>We're located in the heart of Rajkot's business district. Drop by for a coffee and a demo.</p>
            
            <div class="address-box">
              <div class="addr-item">
                <strong>LeadMan CRM (Mindstien Technologies)</strong>
                <p>S-405, Twinstar, 150 Ring Road, Rajkot - 360005 (Gujarat, India)</p>
              </div>
              <div class="addr-item">
                <strong>Business Hours</strong>
                <p>Monday - Saturday: 10:00 AM - 7:00 PM</p>
              </div>
            </div>
          </div>
          <div class="location-map">
            {/* Placeholder for Map - in a real site, embed Google Maps iframe here */}
            <div class="map-placeholder">
              <img src="https://via.placeholder.com/600x400?text=MAP+VIEW+RAJKOT" alt="Location Map" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 80px;
  }

  .contact-hero {
    padding: 100px 0 40px;
    background: white;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    color: #111827;
    margin-bottom: 24px;
    line-height: 1.1;
  }

  h1 span {
    color: #0a84ff;
  }

  .contact-hero p {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-wrapper {
    background: #f9fafb;
    padding-bottom: 100px;
  }

  .location-section {
    padding: 100px 0;
    background: white;
  }

  .location-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    background: white;
    border-radius: 32px;
    border: 1px solid #e5e7eb;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
  }

  .location-info {
    padding: 60px;
  }

  .badge {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(10, 132, 255, 0.1);
    color: #0a84ff;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .location-info h2 {
    font-size: 2.5rem;
    margin-bottom: 24px;
    color: #111827;
  }

  .location-info h2 span {
    color: #0a84ff;
  }

  .location-info p {
    color: #6b7280;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .address-box {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .addr-item strong {
    display: block;
    color: #111827;
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .addr-item p {
    margin-bottom: 0;
    font-size: 0.95rem;
    color: #4b5563;
  }

  .map-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 992px) {
    .location-card {
      grid-template-columns: 1fr;
    }
    .location-info {
      padding: 40px 24px;
    }
  }
</style>

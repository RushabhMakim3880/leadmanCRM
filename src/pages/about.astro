---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout title="About Us | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="about-hero">
      <div class="container">
        <h1>Built by <span>Business Owners</span>,<br/>For Business Owners</h1>
        <p class="lead">We didn't build LeadMan in a lab. We built it in the real world, solving real sales challenges for Indian SMEs.</p>
      </div>
    </section>

    <section class="story-section">
      <div class="container grid-2">
        <div class="story-content">
          <span class="badge">Our Heritage</span>
          <h2>A Decade of <span>Digital Excellence</span></h2>
          <div class="story-body">
            <p>
              Leadman CRM is built with a simple belief: software should do more than just store data. It should help business owners and leaders understand what is happening in their sales process, take better decisions, and act at the right time for growth.
            </p>
            <p>
              Leadman was shaped through real experience of working with more than 20 businesses and building solutions around their actual day-to-day needs. By learning their pain points and understanding proven sales journey methods like <strong>SPANCO</strong>, we developed a CRM that is structured, easy to use, and suitable for growing SME businesses.
            </p>
          </div>
        </div>
        <div class="story-visual">
          <div class="heritage-stat-box">
            <div class="stat-main">12+</div>
            <div class="stat-title">Years of Engineering</div>
            <p>Building high-performance sales ecosystems that empower India's leading SMEs.</p>
            <div class="stat-accent"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="deep-dive-section dark-premium">
      <div class="container">
        <div class="intro-story text-center">
          <span class="badge-alt">The Evolution</span>
          <h2>Ending the Era of <span>Spreadsheet Chaos</span></h2>
          <p>
            Leadman CRM was born from a singular observation: too many brilliant SMEs were being held back by "fragmented friction." We created Leadman to turn that chaos into a competitive advantage.
          </p>
        </div>

        <div class="dive-grid">
          <div class="glass-card">
            <div class="glass-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h3>The Catalyst for Innovation</h3>
            <p class="glass-intro">We didn't just build a tool; we engineered a transition from survival to systematic growth.</p>
            <ul class="glass-list">
              <li><strong>Unified Sales Engine:</strong> Transition from Excel fatigue to a high-performance, automated sales ecosystem.</li>
              <li><strong>Intelligence-Driven:</strong> Prioritize data-driven insights and AI-assisted follow-ups to close more deals.</li>
            </ul>
          </div>

          <div class="glass-card">
            <div class="glass-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3>Democratizing Enterprise Power</h3>
            <p class="glass-intro">Advanced sales intelligence shouldn't be a luxury reserved for industry giants.</p>
            <ul class="glass-list">
              <li><strong>Scale Without Complexity:</strong> Enterprise visibility and control with the simplicity of an SME tool.</li>
              <li><strong>The Competitive Edge:</strong> Outmaneuver bigger players by systematizing your sales journey without the high costs.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="philosophy-section">
      <div class="container">
        <div class="philosophy-grid">
          <div class="philo-card">
            <div class="philo-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Mission</h3>
            <p>To empower Indian SMEs with the tools they need to automate sales, increase productivity, and scale without friction.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            </div>
            <h3>Philosophy</h3>
            <p>We believe technology should serve the process, not dictate it. Our software is designed to be invisible yet indispensable.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Commitment</h3>
            <p>We don't just sell software. We partner with you for onboarding, implementation, and long-term success.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="team-cta">
      <div class="container">
        <div class="team-banner dark-section">
          <h2>Join the Growth Revolution</h2>
          <p>Experience the CRM that's transforming sales for 250+ businesses across India.</p>
          <a href="#" class="btn btn-primary open-modal">Start Your Journey</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 80px;
  }

  .about-hero {
    padding: 80px 0 40px;
    background: white;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #111827;
    margin-bottom: 32px;
    line-height: 1.1;
  }

  h1 span {
    color: #0a84ff;
  }

  .lead {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .story-section {
    padding: 60px 0;
    background: #f9fafb;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(10, 132, 255, 0.1);
    color: #0a84ff;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .story-content h2 {
    font-size: 3rem;
    margin-bottom: 24px;
    color: #111827;
    line-height: 1.2;
  }

  .story-content h2 span {
    color: #0066cc;
  }

  .story-body p {
    font-size: 1.15rem;
    color: #4b5563;
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .heritage-stat-box {
    background: #0066cc;
    padding: 60px 48px;
    border-radius: 48px;
    color: white;
    box-shadow: 0 40px 80px rgba(0, 102, 204, 0.2);
    position: relative;
    overflow: hidden;
  }

  .heritage-stat-box::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
  }

  .stat-main {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: -3px;
  }

  .stat-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .heritage-stat-box p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin: 0;
  }

  .stat-accent {
    width: 60px;
    height: 6px;
    background: white;
    margin-top: 32px;
    border-radius: 3px;
  }

  .philosophy-section {
    padding: 60px 0;
    background: white;
  }

  .philosations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }
  
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .philo-card {
    padding: 40px;
    border-radius: 24px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .philo-card:hover {
    border-color: #0a84ff;
    background: white;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
  }

  .philo-icon svg {
    width: 48px;
    height: 48px;
    color: #0066cc;
  }

  .philo-card h3 {
    font-size: 1.5rem;
    color: #111827;
    margin-bottom: 16px;
  }

  .philo-card p {
    color: #4b5563;
    line-height: 1.6;
  }

  .deep-dive-section {
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
  }

  .intro-story {
    max-width: 900px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .intro-story h2 {
    font-size: 3rem;
    margin-bottom: 24px;
    color: #111827;
  }

  .intro-story h2 span {
    color: #0066cc;
  }

  .intro-story p {
    font-size: 1.25rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .dive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .dark-premium {
    background: #0b1120;
    padding: 100px 0;
    color: white;
    position: relative;
    overflow: hidden;
  }

  .dark-premium::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  }

  .badge-alt {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(0, 102, 204, 0.2);
    color: #38bdf8;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 24px;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .dark-premium h2 {
    font-size: 3.5rem;
    color: white;
    margin-bottom: 24px;
  }

  .dark-premium h2 span {
    color: #38bdf8;
  }

  .dark-premium .intro-story p {
    color: #94a3b8;
    font-size: 1.3rem;
  }

  .glass-card {
    background: rgba(30, 41, 59, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 60px 48px;
    border-radius: 40px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .glass-card:hover {
    transform: scale(1.02);
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 20px rgba(56, 189, 248, 0.1);
  }

  .glass-icon {
    width: 64px;
    height: 64px;
    background: #0066cc;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32px;
    box-shadow: 0 10px 20px rgba(0, 102, 204, 0.3);
  }

  .glass-icon svg {
    width: 32px;
    height: 32px;
    color: white;
  }

  .glass-card h3 {
    font-size: 2rem;
    color: white;
    margin-bottom: 20px;
  }

  .glass-intro {
    font-size: 1.15rem;
    color: #38bdf8;
    font-weight: 700;
    margin-bottom: 32px;
    line-height: 1.5;
  }

  .glass-list {
    list-style: none;
    padding: 0;
  }

  .glass-list li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 24px;
    color: #94a3b8;
    line-height: 1.7;
    font-size: 1.1rem;
  }

  .glass-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #38bdf8;
    font-weight: 900;
  }

  .glass-list strong {
    color: white;
  }

  @media (max-width: 768px) {
    .dive-grid {
      grid-template-columns: 1fr;
    }
    .intro-story p {
      font-size: 1.1rem;
    }
  }

  .team-cta {
    padding: 60px 0;
  }

  .team-banner {
    background: #111827;
    padding: 80px;
    border-radius: 32px;
    text-align: center;
    color: white;
  }

  .team-banner h2 {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .team-banner p {
    font-size: 1.1rem;
    color: #9ca3af;
    margin-bottom: 40px;
  }

  .btn-primary {
    background: #0a84ff;
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-block;
  }

  @media (max-width: 992px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 80px 0 40px;
    }
    .team-banner {
      padding: 40px 20px;
    }
  }
</style>

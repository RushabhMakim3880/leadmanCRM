---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout title="About Us | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="about-hero">
      <div class="container">
        <h1>Built to Solve Real Sales <br/><span>Problems for SMEs</span></h1>
        <p class="lead">We didn't build LeadMan in a lab. We built it in the real world, solving real sales challenges for Indian SMEs.</p>
      </div>
    </section>

    <section class="story-section">
      <div class="container grid-2">
        <div class="story-content">
          <span class="badge">Our Heritage</span>
          <h2>Why We Built <span>Leadman CRM</span></h2>
          <div class="story-body">
            <p>
              We know that running a business is hard work. Managing leads, tracking sales, and keeping everything organized can feel overwhelming. But we believe it doesn't have to be this way. That’s why we built Leadman CRM: to take the complexity out of managing your business and give you a system that works with you.
            </p>
            <p>
              With Leadman, you’re not just managing leads—you’re turning them into opportunities. You’re not just tracking sales—you’re boosting them. And you’re not just gathering data—you’re making smarter, data-driven decisions. Leadman adapts to your business, helping you track every lead, automate follow-ups, and get deep insights into your sales, all in one place.
            </p>
            <p>
              Leadman CRM is specially designed for sales productivity and growth. It’s your partner in growth, the tool that makes your business run smoother, your team more productive, and your sales more effective. Leadman isn’t just software; it’s the backbone of your business’s success.
            </p>
            <p>
              Whether you’re a small business just starting out or an established company looking to streamline your sales pipeline, Leadman CRM is here to help you unlock your full potential. Start with Leadman CRM today—let’s grow your business, one lead at a time.
            </p>
          </div>
        </div>
        <div class="story-visual">
          <div class="heritage-stat-box">
            <div class="stat-main">12+</div>
            <div class="stat-title">Years of Engineering</div>
            <p>Building high-performance sales ecosystems that empower India's leading SMEs.</p>
            <div class="stat-accent"></div>
          </div>
        </div>
      </div>
    </section>



    <section class="philosophy-section">
      <div class="container">
        <div class="philosophy-grid">
          <div class="philo-card">
            <div class="philo-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Mission</h3>
            <p>To Empower Indian SMEs to simplify sales management and help them convert more leads without complexity.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            </div>
            <h3>Philosophy</h3>
            <p>We believe technology should serve the process, not dictate it. Our software is designed to be invisible yet indispensable.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Commitment</h3>
            <p>We don't just sell software. We partner with you for onboarding, implementation, and long-term success.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="what-makes-us-different-section">
      <div class="container">
        <div class="intro-story text-center">
          <span class="badge-alt" style="color: #0066cc; background: rgba(0, 102, 204, 0.1); border: none;">The Leadman Advantage</span>
          <h2 style="color: #111827;">What Makes Us <span>Different</span></h2>
        </div>
        
        <div class="diff-grid">
          <div class="diff-card">
            <div class="diff-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg></div>
            <h3>Built for Indian Workflows</h3>
          </div>
          <div class="diff-card">
            <div class="diff-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
            <h3>Focused on Simplicity, Not Complexity</h3>
          </div>
          <div class="diff-card">
            <div class="diff-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></div>
            <h3>Fast Implementation (No Long Setup)</h3>
          </div>
          <div class="diff-card">
            <div class="diff-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg></div>
            <h3>WhatsApp-First Approach</h3>
          </div>
        </div>

        <div class="video-testimonial-placeholder">
          <div class="play-button">
            <svg viewBox="0 0 24 24" fill="white" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>
          <p>Hear from our successful partners</p>
        </div>
      </div>
    </section>

    <section class="team-cta">
      <div class="container">
        <div class="team-banner dark-section">
          <h2>Join the Growth Revolution</h2>
          <p>Experience the CRM that's transforming sales for SMEs across India.</p>
          <a href="#" class="btn btn-primary open-modal">Book Demo</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 80px;
  }

  .about-hero {
    padding: 80px 0 40px;
    background: white;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #111827;
    margin-bottom: 32px;
    line-height: 1.1;
  }

  h1 span {
    color: #0a84ff;
  }

  .lead {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .story-section {
    padding: 60px 0;
    background: #f9fafb;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(10, 132, 255, 0.1);
    color: #0a84ff;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .story-content h2 {
    font-size: 3rem;
    margin-bottom: 24px;
    color: #111827;
    line-height: 1.2;
  }

  .story-content h2 span {
    color: #0066cc;
  }

  .story-body p {
    font-size: 1.15rem;
    color: #4b5563;
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .heritage-stat-box {
    background: #0066cc;
    padding: 60px 48px;
    border-radius: 48px;
    color: white;
    box-shadow: 0 40px 80px rgba(0, 102, 204, 0.2);
    position: relative;
    overflow: hidden;
  }

  .heritage-stat-box::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
  }

  .stat-main {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: -3px;
  }

  .stat-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .heritage-stat-box p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin: 0;
  }

  .stat-accent {
    width: 60px;
    height: 6px;
    background: white;
    margin-top: 32px;
    border-radius: 3px;
  }

  .philosophy-section {
    padding: 60px 0;
    background: white;
  }

  .philosations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }
  
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .philo-card {
    padding: 40px;
    border-radius: 24px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .philo-card:hover {
    border-color: #0a84ff;
    background: white;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
  }

  .philo-icon svg {
    width: 48px;
    height: 48px;
    color: #0066cc;
  }

  .philo-card h3 {
    font-size: 1.5rem;
    color: #111827;
    margin-bottom: 16px;
  }

  .philo-card p {
    color: #4b5563;
    line-height: 1.6;
  }

  .what-makes-us-different-section {
    padding: 80px 0;
    background: #f8fafc;
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 60px;
  }

  .diff-card {
    background: white;
    padding: 40px 24px;
    border-radius: 20px;
    text-align: center;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
  }

  .diff-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    border-color: #0066cc;
  }

  .diff-icon {
    width: 64px;
    height: 64px;
    background: #f0f7ff;
    color: #0066cc;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }

  .diff-icon svg {
    width: 32px;
    height: 32px;
  }

  .diff-card h3 {
    font-size: 1.125rem;
    color: #1e293b;
    line-height: 1.5;
  }

  .video-testimonial-placeholder {
    max-width: 800px;
    margin: 0 auto;
    height: 450px;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .video-testimonial-placeholder::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1600&q=80') center/cover;
    opacity: 0.3;
    mix-blend-mode: overlay;
  }

  .play-button {
    width: 80px;
    height: 80px;
    background: #0066cc;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 0 0 0 rgba(0, 102, 204, 0.5);
    animation: pulse 2s infinite;
  }

  .play-button:hover {
    transform: scale(1.1);
  }

  .play-button svg {
    width: 32px;
    height: 32px;
    margin-left: 6px;
  }

  .video-testimonial-placeholder p {
    color: white;
    font-size: 1.25rem;
    font-weight: 700;
    z-index: 2;
    margin-top: 24px;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 102, 204, 0.7); }
    70% { box-shadow: 0 0 0 20px rgba(0, 102, 204, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 102, 204, 0); }
  }

  @media (max-width: 900px) {
    .diff-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .video-testimonial-placeholder {
      height: 300px;
    }
  }

  @media (max-width: 600px) {
    .diff-grid {
      grid-template-columns: 1fr;
    }
  }

  .deep-dive-section {
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
  }

  .intro-story {
    max-width: 900px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .intro-story h2 {
    font-size: 3rem;
    margin-bottom: 24px;
    color: #111827;
  }

  .intro-story h2 span {
    color: #0066cc;
  }

  .intro-story p {
    font-size: 1.25rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .dive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .dark-premium {
    background: #0b1120;
    padding: 100px 0;
    color: white;
    position: relative;
    overflow: hidden;
  }

  .dark-premium::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  }

  .badge-alt {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(0, 102, 204, 0.2);
    color: #38bdf8;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 24px;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .dark-premium h2 {
    font-size: 3.5rem;
    color: white;
    margin-bottom: 24px;
  }

  .dark-premium h2 span {
    color: #38bdf8;
  }

  .dark-premium .intro-story p {
    color: #94a3b8;
    font-size: 1.3rem;
  }

  .glass-card {
    background: rgba(30, 41, 59, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 60px 48px;
    border-radius: 40px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .glass-card:hover {
    transform: scale(1.02);
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 20px rgba(56, 189, 248, 0.1);
  }

  .glass-icon {
    width: 64px;
    height: 64px;
    background: #0066cc;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32px;
    box-shadow: 0 10px 20px rgba(0, 102, 204, 0.3);
  }

  .glass-icon svg {
    width: 32px;
    height: 32px;
    color: white;
  }

  .glass-card h3 {
    font-size: 2rem;
    color: white;
    margin-bottom: 20px;
  }

  .glass-intro {
    font-size: 1.15rem;
    color: #38bdf8;
    font-weight: 700;
    margin-bottom: 32px;
    line-height: 1.5;
  }

  .glass-list {
    list-style: none;
    padding: 0;
  }

  .glass-list li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 24px;
    color: #94a3b8;
    line-height: 1.7;
    font-size: 1.1rem;
  }

  .glass-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #38bdf8;
    font-weight: 900;
  }

  .glass-list strong {
    color: white;
  }

  @media (max-width: 768px) {
    .dive-grid {
      grid-template-columns: 1fr;
    }
    .intro-story p {
      font-size: 1.1rem;
    }
  }

  .team-cta {
    padding: 60px 0;
  }

  .team-banner {
    background: #111827;
    padding: 80px;
    border-radius: 32px;
    text-align: center;
    color: white;
  }

  .team-banner h2 {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .team-banner p {
    font-size: 1.1rem;
    color: #9ca3af;
    margin-bottom: 40px;
  }

  .btn-primary {
    background: #0a84ff;
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-block;
  }

  @media (max-width: 992px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 80px 0 40px;
    }
    .team-banner {
      padding: 40px 20px;
    }
  }
</style>

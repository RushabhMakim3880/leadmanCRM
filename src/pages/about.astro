---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout title="About Us | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="about-hero">
      <div class="container">
        <h1>Built by <span>Business Owners</span>,<br/>For Business Owners</h1>
        <p class="lead">We didn't build LeadMan in a lab. We built it in the real world, solving real sales challenges for Indian SMEs.</p>
      </div>
    </section>

    <section class="story-section">
      <div class="container grid-2">
        <div class="story-content">
          <span class="badge">Our Story</span>
          <h2>A Decade of <span>Digital Excellence</span></h2>
          <p>
            Leadman CRM is built with a simple belief: software should do more than just store data. It should help business owners and leaders understand what is happening in their sales process, take better decisions, and act at the right time for growth.
          </p>
          <p>
            Leadman was shaped through real experience of working with more than 20 businesses and building solutions around their actual day-to-day needs. By learning their pain points, understanding practical sales processes, and following proven sales journey methods like <strong>SPANCO</strong>, we developed a CRM that is structured, easy to use, and suitable for growing SME businesses.
          </p>
          <p>
            We also understand that every business does not need a heavy or overly complex system. A practical business needs a solution that fits its size, process, and growth stage. That is why Leadman CRM is designed especially for SMEs — to give the right level of control, visibility, and flexibility without making daily work complicated.
          </p>
        </div>
        <div class="story-visual">
          <div class="experience-card">
            <span class="exp-num">12+</span>
            <span class="exp-text">Years of Engineering Excellence</span>
          </div>
        </div>
      </div>
    </section>

    <section class="deep-dive-section section-padding">
      <div class="container">
        <div class="intro-story">
          <h2>Ending the Era of <span>Spreadsheet Chaos</span></h2>
          <p>
            Leadman CRM was born from a singular observation: too many brilliant SMEs were being held back by "fragmented friction." We saw business leaders drowning in endless spreadsheets, manual WhatsApp follow-ups, and scattered data silos that stifled growth. We created Leadman to turn that chaos into a competitive advantage.
          </p>
        </div>

        <div class="dive-grid">
          <div class="dive-card">
            <div class="card-icon-mini">💡</div>
            <h3>The Catalyst for Innovation</h3>
            <p class="card-intro">We didn't just build a tool; we engineered a transition from survival to systematic growth.</p>
            <ul>
              <li><strong>Unified Sales Engine:</strong> We help MSMEs graduate from the fatigue of Excel and WhatsApp manual entry to a high-performance, automated sales ecosystem.</li>
              <li><strong>Intelligence-Driven Action:</strong> Our architecture prioritizes data-driven insights and AI-assisted follow-ups, ensuring your team spends less time "managing" and more time closing.</li>
            </ul>
          </div>

          <div class="dive-card">
            <div class="card-icon-mini">🚀</div>
            <h3>Democratizing Enterprise Power</h3>
            <p class="card-intro">We believe that advanced sales intelligence shouldn't be a luxury reserved for industry giants.</p>
            <ul>
              <li><strong>Scale Without Complexity:</strong> Leadman is purpose-built to give you the visibility, control, and automation of a global enterprise with the simplicity and agility of an SME.</li>
              <li><strong>The Competitive Edge:</strong> We empower you to outmaneuver bigger players by systematizing your sales journey, leveling the playing field without the enterprise price tag.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="philosophy-section">
      <div class="container">
        <div class="philosophy-grid">
          <div class="philo-card">
            <div class="philo-icon">🎯</div>
            <h3>Mission</h3>
            <p>To empower Indian SMEs with the tools they need to automate sales, increase productivity, and scale without friction.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">💡</div>
            <h3>Philosophy</h3>
            <p>We believe technology should serve the process, not dictate it. Our software is designed to be invisible yet indispensable.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">🤝</div>
            <h3>Commitment</h3>
            <p>We don't just sell software. We partner with you for onboarding, implementation, and long-term success.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="team-cta">
      <div class="container">
        <div class="team-banner dark-section">
          <h2>Join the Growth Revolution</h2>
          <p>Experience the CRM that's transforming sales for 250+ businesses across India.</p>
          <a href="#" class="btn btn-primary open-modal">Start Your Journey</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 80px;
  }

  .about-hero {
    padding: 120px 0 80px;
    background: white;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #111827;
    margin-bottom: 32px;
    line-height: 1.1;
  }

  h1 span {
    color: #0a84ff;
  }

  .lead {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .story-section {
    padding: 100px 0;
    background: #f9fafb;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(10, 132, 255, 0.1);
    color: #0a84ff;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .story-content h2 {
    font-size: 2.5rem;
    margin-bottom: 24px;
    color: #111827;
  }

  .story-content h2 span {
    color: #0a84ff;
  }

  .story-content p {
    font-size: 1.1rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .experience-card {
    background: #0a84ff;
    padding: 60px 40px;
    border-radius: 32px;
    color: white;
    text-align: center;
    box-shadow: 0 20px 40px rgba(10, 132, 255, 0.2);
  }

  .exp-num {
    display: block;
    font-size: 5rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .exp-text {
    font-size: 1.1rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .philosophy-section {
    padding: 100px 0;
    background: white;
  }

  .philosations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }
  
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .philo-card {
    padding: 40px;
    border-radius: 24px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .philo-card:hover {
    border-color: #0a84ff;
    background: white;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
  }

  .philo-icon {
    font-size: 3rem;
    margin-bottom: 24px;
  }

  .philo-card h3 {
    font-size: 1.5rem;
    color: #111827;
    margin-bottom: 16px;
  }

  .philo-card p {
    color: #4b5563;
    line-height: 1.6;
  }

  .deep-dive-section {
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
  }

  .intro-story {
    max-width: 900px;
    margin: 0 auto 60px;
    text-align: center;
  }

  .intro-story h2 {
    font-size: 3rem;
    margin-bottom: 24px;
    color: #111827;
  }

  .intro-story h2 span {
    color: #0066cc;
  }

  .intro-story p {
    font-size: 1.25rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .dive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .dive-card {
    background: #ffffff;
    padding: 48px;
    border-radius: 32px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
    transition: all 0.3s ease;
  }

  .dive-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    border-color: #0066cc;
  }

  .card-icon-mini {
    font-size: 2.5rem;
    margin-bottom: 24px;
  }

  .dive-card h3 {
    font-size: 1.75rem;
    color: #111827;
    margin-bottom: 16px;
  }

  .card-intro {
    font-weight: 600;
    color: #0066cc;
    margin-bottom: 24px;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .dive-card ul {
    list-style: none;
    padding: 0;
  }

  .dive-card li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 20px;
    color: #4b5563;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .dive-card li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #0066cc;
    font-weight: 800;
  }

  @media (max-width: 768px) {
    .dive-grid {
      grid-template-columns: 1fr;
    }
    .intro-story p {
      font-size: 1.1rem;
    }
  }

  .team-cta {
    padding: 100px 0;
  }

  .team-banner {
    background: #111827;
    padding: 80px;
    border-radius: 32px;
    text-align: center;
    color: white;
  }

  .team-banner h2 {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .team-banner p {
    font-size: 1.1rem;
    color: #9ca3af;
    margin-bottom: 40px;
  }

  .btn-primary {
    background: #0a84ff;
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-block;
  }

  @media (max-width: 992px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 80px 0 40px;
    }
    .team-banner {
      padding: 40px 20px;
    }
  }
</style>

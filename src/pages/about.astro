---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout title="About Us | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="about-hero">
      <div class="container">
        <h1>Built by <span>Business Owners</span>,<br/>For Business Owners</h1>
        <p class="lead">We didn't build LeadMan in a lab. We built it in the real world, solving real sales challenges for Indian SMEs.</p>
      </div>
    </section>

    <section class="story-section">
      <div class="container grid-2">
        <div class="story-content">
          <span class="badge">Our Story</span>
          <h2>A Decade of <span>Digital Excellence</span></h2>
          <p>
            LeadMan is a product of <strong>Mindstien Technologies</strong>. With over 12 years of experience 
            in the digital landscape, our team has delivered 250+ projects across 20+ SME verticals.
          </p>
          <p>
            We realized that most CRMs were either too complex for small teams or too simple for growing 
            businesses. LeadMan was born to bridge that gap—providing enterprise-grade features with 
            the simplicity that Indian business owners need.
          </p>
        </div>
        <div class="story-visual">
          <div class="experience-card">
            <span class="exp-num">12+</span>
            <span class="exp-text">Years of Engineering Excellence</span>
          </div>
        </div>
      </div>
    </section>

    <section class="philosophy-section">
      <div class="container">
        <div class="philosophy-grid">
          <div class="philo-card">
            <div class="philo-icon">🎯</div>
            <h3>Mission</h3>
            <p>To empower Indian SMEs with the tools they need to automate sales, increase productivity, and scale without friction.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">💡</div>
            <h3>Philosophy</h3>
            <p>We believe technology should serve the process, not dictate it. Our software is designed to be invisible yet indispensable.</p>
          </div>
          <div class="philo-card">
            <div class="philo-icon">🤝</div>
            <h3>Commitment</h3>
            <p>We don't just sell software. We partner with you for onboarding, implementation, and long-term success.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="team-cta">
      <div class="container">
        <div class="team-banner">
          <h2>Join the Growth Revolution</h2>
          <p>Experience the CRM that's transforming sales for 250+ businesses across India.</p>
          <a href="/contact" class="btn btn-primary">Start Your Journey</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 80px;
  }

  .about-hero {
    padding: 120px 0 80px;
    background: white;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #111827;
    margin-bottom: 32px;
    line-height: 1.1;
  }

  h1 span {
    color: #0a84ff;
  }

  .lead {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .story-section {
    padding: 100px 0;
    background: #f9fafb;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(10, 132, 255, 0.1);
    color: #0a84ff;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .story-content h2 {
    font-size: 2.5rem;
    margin-bottom: 24px;
    color: #111827;
  }

  .story-content h2 span {
    color: #0a84ff;
  }

  .story-content p {
    font-size: 1.1rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .experience-card {
    background: #0a84ff;
    padding: 60px 40px;
    border-radius: 32px;
    color: white;
    text-align: center;
    box-shadow: 0 20px 40px rgba(10, 132, 255, 0.2);
  }

  .exp-num {
    display: block;
    font-size: 5rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .exp-text {
    font-size: 1.1rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .philosophy-section {
    padding: 100px 0;
    background: white;
  }

  .philosations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }
  
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .philo-card {
    padding: 40px;
    border-radius: 24px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .philo-card:hover {
    border-color: #0a84ff;
    background: white;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
  }

  .philo-icon {
    font-size: 3rem;
    margin-bottom: 24px;
  }

  .philo-card h3 {
    font-size: 1.5rem;
    color: #111827;
    margin-bottom: 16px;
  }

  .philo-card p {
    color: #4b5563;
    line-height: 1.6;
  }

  .team-cta {
    padding: 100px 0;
  }

  .team-banner {
    background: #111827;
    padding: 80px;
    border-radius: 32px;
    text-align: center;
    color: white;
  }

  .team-banner h2 {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .team-banner p {
    font-size: 1.1rem;
    color: #9ca3af;
    margin-bottom: 40px;
  }

  .btn-primary {
    background: #0a84ff;
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-block;
  }

  @media (max-width: 992px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 80px 0 40px;
    }
    .team-banner {
      padding: 40px 20px;
    }
  }
</style>

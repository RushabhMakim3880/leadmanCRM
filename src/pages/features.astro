---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import WhyChoose from '../components/sections/WhyChoose.astro';

const modules = [
  {
    title: "Lead Management",
    desc: "Capture leads from IndiaMART, TradeIndia, Facebook, and your website automatically. No more manual entry errors.",
    features: ["Auto-capture API", "Duplicate Prevention", "Smart Lead Assignment", "Organization Hierarchy"],
    icon: "🎯"
  },
  {
    title: "Sales Execution",
    desc: "Empower your team with a clear daily agenda. Focus on high-intent follow-ups and close deals faster.",
    features: ["Task Management", "Meeting Notes", "Follow-up Reminders", "Sales Pipeline"],
    icon: "📈"
  },
  {
    title: "Document Automation",
    desc: "Generate professional Quotations, Proforma Invoices, and Invoices in seconds. Unified GST verification included.",
    features: ["Smart Quotation Builder", "PI & Invoice", "GST Verification", "Multi-Currency"],
    icon: "📄"
  },
  {
    title: "Mobility & Field Tracking",
    desc: "Your sales team is mobile; your CRM should be too. Track field visits and punch locations in real-time.",
    features: ["Mobile App", "Location Punching", "Visitor Diary", "Onboarding Support"],
    icon: "📱"
  },
  {
    title: "Reporting & Insights",
    desc: "Data-driven decisions for business owners. Monitor team performance and sales velocity with ease.",
    features: ["Dynamic Dashboard", "Source ROI Tracking", "Sales Analytical reports", "Call Log analysis"],
    icon: "📊"
  },
  {
    title: "Advanced Integrations",
    desc: "Connect LeadMan to your existing ecosystem via Webhooks and open APIs.",
    features: ["WhatsApp API", "Webhooks", "E-Mail integration", "Third-party Apps"],
    icon: "🔗"
  }
];
---

<BaseLayout title="Features | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="features-hero">
      <div class="container">
        <h1>Everything You Need <span>To Capture, Track & Close Leads</span></h1>
        <p>From lead capture to conversion — Leadman CRM gives you complete control over your sales process in one simple system.</p>
      </div>
    </section>

    <section class="modules-section">
      <div class="container">
        <div class="module-grid">
          {modules.map((module) => (
            <div class="module-card">
              <div class="module-icon">
                {module.icon === "🎯" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>}
                {module.icon === "📈" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>}
                {module.icon === "📄" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
                {module.icon === "📱" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>}
                {module.icon === "📊" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>}
                {module.icon === "🔗" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>}
              </div>
              <h3>{module.title}</h3>
              <p>{module.desc}</p>
              <ul class="module-features">
                {module.features.map((f) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <WhyChoose />

    <section class="cta-section">
      <div class="container">
        <div class="cta-card">
          <h2>Ready to see these features in action?</h2>
          <a href="#" class="btn btn-white open-modal">Get a Personalized Demo</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 80px;
  }

  .features-hero {
    padding: 60px 0 40px;
    background: white;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    color: #111827;
    margin-bottom: 24px;
    line-height: 1.1;
  }

  h1 span {
    color: #0a84ff;
  }

  .features-hero p {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
  }

  .modules-section {
    padding: 60px 0;
    background: #f9fafb;
  }

  .module-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
  }

  .module-card {
    background: white;
    padding: 40px;
    border-radius: 24px;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .module-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
    border-color: #0a84ff;
  }

  .module-icon svg {
    width: 48px;
    height: 48px;
    color: #0066cc;
    margin-bottom: 24px;
  }

  .module-card h3 {
    font-size: 1.5rem;
    color: #111827;
    margin-bottom: 16px;
  }

  .module-card p {
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .module-features {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .module-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: #374151;
    font-weight: 600;
  }

  .module-features li svg {
    width: 16px;
    height: 16px;
    color: #10b981;
    flex-shrink: 0;
  }

  .cta-section {
    padding: 60px 0;
    background: white;
  }

  .cta-card {
    background: #0a84ff;
    border-radius: 32px;
    padding: 60px;
    text-align: center;
    color: white;
  }

  .cta-card h2 {
    font-size: 2.5rem;
    margin-bottom: 32px;
  }

  .btn-white {
    background: white;
    color: #0a84ff;
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .btn-white:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 768px) {
    .module-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    
    .module-card {
      padding: 32px 0;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid #e2e8f0;
      background: transparent;
      box-shadow: none;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 8px 16px;
      align-items: center;
    }

    .module-card:last-child {
      border-bottom: none;
    }

    .module-card:hover {
      transform: none;
      box-shadow: none;
    }

    .module-icon svg {
      margin-bottom: 0;
    }

    .module-card h3 {
      margin-bottom: 0;
      font-size: 1.35rem;
    }

    .module-card p {
      grid-column: 1 / -1;
      margin-top: 8px;
    }

    .cta-card {
      padding: 40px 20px;
    }

    .module-features {
      grid-template-columns: 1fr;
      grid-column: 1 / -1;
    }
  }
</style>

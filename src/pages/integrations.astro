---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';

const integrations = [
  {
    name: "WhatsApp API",
    category: "Communication",
    desc: "Send automated alerts, follow-up messages, and proforma invoices directly to your customers' WhatsApp.",
    initials: "WA",
    color: "#25D366"
  },
  {
    name: "IndiaMART",
    category: "Marketplace",
    desc: "Sync leads in real-time from India's largest marketplace. No manual entry needed.",
    initials: "IM",
    color: "#bf0000"
  },
  {
    name: "TradeIndia",
    category: "Marketplace",
    desc: "Seamlessly capture high-intent B2B leads from TradeIndia directly into your sales pipeline.",
    initials: "TI",
    color: "#0056b3"
  },
  {
    name: "Facebook Lead Ads",
    category: "Marketing",
    desc: "Instantly route leads from your Facebook & Instagram campaigns to your sales team.",
    initials: "FB",
    color: "#1877F2"
  },
  {
    name: "Custom Webhooks",
    category: "Developer",
    desc: "Push or pull data between LeadMan and your internal systems or other SaaS apps.",
    initials: "WH",
    color: "#6366f1"
  },
  {
    name: "REST API",
    category: "Developer",
    desc: "Build custom workflows and proprietary integrations with our robust developer API.",
    initials: "API",
    color: "#111827"
  }
];
---

<BaseLayout title="Integrations | LeadMan CRM">
  <Navbar />
  
  <main>
    <section class="integrations-hero">
      <div class="container">
        <span class="badge">Ecosystem</span>
        <h1>Connect your <span class="text-primary">Entire Business</span></h1>
        <p>LeadMan CRM lives where your business does. Integrate with the tools you already use to grow.</p>
      </div>
    </section>

    <section class="integrations-grid-section">
      <div class="container">
        <div class="integrations-grid">
          {integrations.map((item) => (
            <div class="integration-card">
              <div class="card-top">
                <div class="int-icon" style={`background-color: ${item.color}15; color: ${item.color}; border-color: ${item.color}30`}>
                  {item.initials}
                </div>
                <span class="category-tag">{item.category}</span>
              </div>
              <h3>{item.name}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="developer-section section-padding">
      <div class="container">
        <div class="dev-banner dark-section">
          <div class="dev-content">
            <h2>Built for Developers too</h2>
            <p>Our open architecture means you can build anything on top of LeadMan. Access documentation and API keys in your dashboard.</p>
            <a href="#" class="btn btn-primary open-modal">Get in Touch</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 72px;
  }

  .integrations-hero {
    padding: 100px 0 60px;
    background: #ffffff;
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: #e6f0ff;
    color: #0066cc;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 800;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    margin-bottom: 24px;
  }

  .integrations-hero p {
    font-size: 1.25rem;
    color: #4b5563;
    max-width: 800px;
    margin: 0 auto;
  }

  .integrations-grid-section {
    padding: 80px 0;
    background: #f8fbff;
  }

  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
  }

  .integration-card {
    background: #ffffff;
    padding: 40px;
    border-radius: 24px;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .integration-card:hover {
    transform: translateY(-5px);
    border-color: #0066cc;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .int-icon {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
    border: 2px solid transparent;
  }

  .category-tag {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #6b7280;
    padding: 6px 12px;
    background: #f3f4f6;
    border-radius: 8px;
  }

  .integration-card h3 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }

  .integration-card p {
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.6;
  }

  .dev-banner {
    background: #111827;
    border-radius: 40px;
    padding: 80px;
    color: #ffffff;
  }

  .dev-content h2 {
    color: #ffffff;
    font-size: 2.5rem;
    margin-bottom: 24px;
  }

  .dev-content p {
    color: #9ca3af;
    font-size: 1.125rem;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .dev-banner {
      padding: 40px;
    }
    .dev-content h2 {
      font-size: 2rem;
    }
  }
</style>
